{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "motion": {
    "duration": {
      "fast": { "value": "120ms", "type": "duration" },
      "base": { "value": "220ms", "type": "duration" },
      "slow": { "value": "360ms", "type": "duration" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)", "type": "cubicBezier" },
      "entrance": { "value": "cubic-bezier(0.16, 1, 0.3, 1)", "type": "cubicBezier" },
      "exit": { "value": "cubic-bezier(0.7, 0, 0.84, 0)", "type": "cubicBezier" }
    }
  }
}
