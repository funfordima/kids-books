{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "font": {
    "family": {
      "heading": { "value": "'Baloo 2', 'Trebuchet MS', sans-serif", "type": "fontFamily" },
      "body": { "value": "'Source Serif 4', Georgia, serif", "type": "fontFamily" },
      "ui": { "value": "'Atkinson Hyperlegible', 'Segoe UI', sans-serif", "type": "fontFamily" }
    },
    "size": {
      "xs": { "value": "12px", "type": "fontSize" },
      "sm": { "value": "14px", "type": "fontSize" },
      "md": { "value": "16px", "type": "fontSize" },
