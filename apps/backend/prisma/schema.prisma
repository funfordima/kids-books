generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  GUARDIAN
  ADMIN

  @@map("user_role")
}

enum SubscriptionStatus {
  INACTIVE
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  PAUSED
  CANCELED

  @@map("subscription_status")
}

enum StripeEventProcessingStatus {
  PROCESSED
  IGNORED
  FAILED

  @@map("stripe_event_processing_status")
}

enum PdfExportStatus {
  PENDING
  READY
  FAILED

  @@map("pdf_export_status")
}

enum BookStatus {
  DRAFT
  GENERATING
  READY
  FAILED
  ARCHIVED

  @@map("book_status")
}

enum TemplateVisibility {
  PRIVATE
  PUBLIC

  @@map("template_visibility")
}

enum TemplatePublicationStatus {
  DRAFT
  CANDIDATE
  ACCEPTED
  REJECTED

  @@map("template_publication_status")
}

enum CharacterKind {
  PARENT
  CHILD
  FRIEND
  PET
  SIBLING
  OTHER

  @@map("character_kind")
}

enum PictureStatus {
  PENDING
  GENERATING
  READY
  FAILED

  @@map("picture_status")
}

enum JobType {
  BOOK_GENERATION
  PICTURE_GENERATION
  TEMPLATE_PUBLICATION
  PDF_EXPORT

  @@map("job_type")
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  CANCELED
  EXPIRED

  @@map("job_status")
}

enum RatingValue {
  THUMBS_UP
  THUMBS_DOWN

  @@map("rating_value")
}

model User {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String             @unique
  displayName        String?            @map("display_name")
  googleSubject      String?            @unique @map("google_subject")
  role               UserRole           @default(GUARDIAN)
  stripeCustomerId   String?            @unique @map("stripe_customer_id")
  subscriptionStatus SubscriptionStatus @default(INACTIVE) @map("subscription_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  books           Book[]
  characters      Character[]
  jobs            Job[]
  ratings         Rating[]
  referralProgram ReferralProgram?
  referredByLinks ReferralProgram[] @relation("ReferralRecipient")
  subscriptions   Subscription[]
  stripeEvents    StripeWebhookEvent[]
  templates       Template[]
  pdfExports      PdfExport[]
  disabledTemplates Template[] @relation("TemplateDisabledBy")
  publicationAudits TemplatePublicationAudit[]

  @@map("users")
}

model Subscription {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripePriceId        String?            @map("stripe_price_id")
  plan                 String
  status               SubscriptionStatus
  providerStatus       String?            @map("provider_status")
  currentPeriodStart   DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime?          @map("current_period_end") @db.Timestamptz(6)
  trialStartedAt       DateTime?          @map("trial_started_at") @db.Timestamptz(6)
  trialEndsAt          DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  cancelAt             DateTime?          @map("cancel_at") @db.Timestamptz(6)
  canceledAt           DateTime?          @map("canceled_at") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  latestEventCreatedAt DateTime?          @map("latest_event_created_at") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([latestEventCreatedAt])
  @@map("subscriptions")
}

model StripeWebhookEvent {
  id               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stripeEventId    String                      @unique @map("stripe_event_id")
  type             String
  providerObjectId String?                     @map("provider_object_id")
  providerCreatedAt DateTime                   @map("provider_created_at") @db.Timestamptz(6)
  processingStatus StripeEventProcessingStatus @map("processing_status")
  result           Json?
  errorCode        String?                     @map("error_code")
  userId           String?                     @map("user_id") @db.Uuid
  receivedAt       DateTime                    @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime?                   @map("processed_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, providerCreatedAt])
  @@index([providerObjectId])
  @@index([userId])
  @@map("stripe_webhook_events")
}

model Template {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId           String?                   @map("owner_user_id") @db.Uuid
  sourceBookId          String?                   @unique @map("source_book_id") @db.Uuid
  title                 String
  description           String
  storyType             String                    @map("story_type")
  educationalSubtype    String?                   @map("educational_subtype")
  ageMin                Int                       @map("age_min")
  ageMax                Int                       @map("age_max")
  visibility            TemplateVisibility        @default(PRIVATE)
  publicationStatus     TemplatePublicationStatus @default(DRAFT) @map("publication_status")
  uniquenessFingerprint String?                   @unique @map("uniqueness_fingerprint")
  pipelineVersion       String?                   @map("pipeline_version")
  fingerprintVersion    String?                   @map("fingerprint_version")
  semanticVersion       String?                   @map("semantic_version")
  semanticModel         String?                   @map("semantic_model")
  semanticAlgorithm     String?                   @map("semantic_algorithm")
  semanticSignature     Json?                     @map("semantic_signature")
  generalizedConfig     Json                      @map("generalized_config")
  safetyReview          Json?                     @map("safety_review")
  publicationDecision   Json?                     @map("publication_decision")
  disabledAt            DateTime?                 @map("disabled_at") @db.Timestamptz(6)
  disabledByUserId      String?                   @map("disabled_by_user_id") @db.Uuid
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  books      Book[]
  jobs       Job[]
  owner      User?  @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  sourceBook Book?  @relation("TemplateSourceBook", fields: [sourceBookId], references: [id], onDelete: SetNull)
  disabledBy User?  @relation("TemplateDisabledBy", fields: [disabledByUserId], references: [id], onDelete: SetNull)
  publicationAudits TemplatePublicationAudit[]

  @@index([visibility, publicationStatus])
  @@index([pipelineVersion, fingerprintVersion, semanticVersion])
  @@index([storyType, educationalSubtype])
  @@index([ownerUserId])
  @@map("templates")
}

model TemplatePublicationAudit {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceBookId         String?  @map("source_book_id") @db.Uuid
  templateId           String?  @map("template_id") @db.Uuid
  actorType            String   @map("actor_type")
  actorId              String?  @map("actor_id") @db.Uuid
  pipelineVersion      String   @map("pipeline_version")
  fingerprintVersion   String   @map("fingerprint_version")
  semanticVersion      String   @map("semantic_version")
  moderationVersion    String   @map("moderation_version")
  privacyPassed        Boolean  @map("privacy_passed")
  moderationPassed     Boolean  @map("moderation_passed")
  fingerprintCollision Boolean  @map("fingerprint_collision")
  semanticCatalogReady Boolean  @map("semantic_catalog_ready")
  semanticMaxScore     Float?   @map("semantic_max_score")
  matchedTemplateIds   Json     @map("matched_template_ids")
  outcome              String
  reasonCode           String   @map("reason_code")
  retryOfAuditId       String?  @map("retry_of_audit_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor        User?                       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  sourceBook   Book?                       @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)
  template     Template?                   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  retryOfAudit TemplatePublicationAudit?   @relation("TemplatePublicationRetry", fields: [retryOfAuditId], references: [id], onDelete: SetNull)
  retries      TemplatePublicationAudit[]  @relation("TemplatePublicationRetry")

  @@unique([sourceBookId, pipelineVersion])
  @@index([sourceBookId, pipelineVersion])
  @@index([templateId])
  @@index([outcome, reasonCode])
  @@map("template_publication_audits")
}

model Book {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  templateId       String?    @map("template_id") @db.Uuid
  title            String?
  status           BookStatus @default(DRAFT)
  config           Json
  storyText        Json?      @map("story_text")
  moderationResult Json?      @map("moderation_result")
  shareTokenHash   String?    @unique @map("share_token_hash")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  characters     Character[]
  jobs           Job[]
  pages          BookPage[]
  pictures       Picture[]
  ratings        Rating[]
  sourceTemplate Template?   @relation("TemplateSourceBook")
  template       Template?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pdfExports     PdfExport[]
  publicationAudits TemplatePublicationAudit[]

  @@index([userId, status])
  @@index([templateId])
  @@map("books")
}

model PdfExport {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  bookId             String          @map("book_id") @db.Uuid
  contentVersion     String          @map("content_version")
  layoutVersion      String          @map("layout_version")
  status             PdfExportStatus @default(PENDING)
  renderLease        String?         @map("render_lease") @db.Uuid
  storageBucket      String?         @map("storage_bucket")
  storageKey         String?         @map("storage_key")
  sha256             String?
  byteSize           Int?            @map("byte_size")
  contentType        String?         @map("content_type")
  contentDisposition String?         @map("content_disposition")
  errorCode          String?         @map("error_code")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt        DateTime?       @map("completed_at") @db.Timestamptz(6)

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, contentVersion, layoutVersion])
  @@index([userId])
  @@index([bookId, status])
  @@map("pdf_exports")
}

model Character {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  bookId      String        @map("book_id") @db.Uuid
  kind        CharacterKind
  displayName String        @map("display_name")
  attributes  Json?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([bookId])
  @@map("characters")
}

model BookPage {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookId                  String   @map("book_id") @db.Uuid
  pageNumber              Int      @map("page_number")
  textContent             String   @map("text_content")
  illustrationDescription String   @map("illustration_description")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  picture Picture?

  @@unique([bookId, pageNumber])
  @@map("book_pages")
}

model Picture {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookId          String        @map("book_id") @db.Uuid
  pageId          String        @unique @map("page_id") @db.Uuid
  jobId           String?       @unique @map("job_id") @db.Uuid
  status          PictureStatus @default(PENDING)
  prompt          String
  style           String
  storageBucket   String?       @map("storage_bucket")
  storageKey      String?       @map("storage_key")
  imageUrl        String?       @map("image_url")
  providerAssetId String?       @map("provider_asset_id")
  safetyReview    Json?         @map("safety_review")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  book Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  job  Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  page BookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([bookId, status])
  @@map("pictures")
}

model Job {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  bookId        String?   @map("book_id") @db.Uuid
  templateId    String?   @map("template_id") @db.Uuid
  externalJobId String?   @unique @map("external_job_id")
  type          JobType
  status        JobStatus @default(QUEUED)
  payload       Json
  result        Json?
  errorCode     String?   @map("error_code")
  errorMessage  String?   @map("error_message")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3) @map("max_attempts")
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  book     Book?     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pictures Picture[]
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([type, status])
  @@index([userId])
  @@index([bookId])
  @@map("jobs")
}

model Rating {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  bookId    String      @map("book_id") @db.Uuid
  value     RatingValue
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([userId])
  @@map("ratings")
}

model ReferralProgram {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  referralCode     String   @unique @map("referral_code")
  referredByUserId String?  @map("referred_by_user_id") @db.Uuid
  acceptedCount    Int      @default(0) @map("accepted_count")
  rewardState      Json?    @map("reward_state")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  referredByUser User? @relation("ReferralRecipient", fields: [referredByUserId], references: [id], onDelete: SetNull)
  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([referredByUserId])
  @@map("referral_programs")
}
