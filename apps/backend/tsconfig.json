{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "incremental": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "removeComments": true,
    "sourceMap": true,
    "target": "ES2022",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "typeRoots": ["../../node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
