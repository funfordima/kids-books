# Local-development values only. Copy this file to infra/docker/.env and
# replace the example passwords if the stack is used outside one workstation.

POSTGRES_DB=kids_books
POSTGRES_USER=kids_books
POSTGRES_PASSWORD=local_postgres_change_me
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

REDIS_PASSWORD=local_redis_change_me
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

MINIO_ROOT_USER=kids_books_local
MINIO_ROOT_PASSWORD=local_minio_change_me_123
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
